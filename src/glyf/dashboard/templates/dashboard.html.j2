{%- import "components/icons.j2" as icons -%}
{%- import "components/toolbar.j2" as toolbar -%}
{%- import "components/chart_card.j2" as chart_cards -%}
{%- import "components/component_card.j2" as component_cards -%}
{%- import "components/source_drawer.j2" as source_drawer -%}
{%- import "components/ai_panel.j2" as ai_panel -%}
<!doctype html>
<html lang="en" data-theme="{{ dashboard_config.theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ dashboard.title }}</title>
  {% if assets.inline_css %}
  <style>{{ assets.inline_css }}</style>
  {% else %}
  <link rel="stylesheet" href="../{{ assets.css_href }}">
  {% endif %}
  {% if has_interactive_charts %}
  <script src="https://cdn.jsdelivr.net/npm/vega@6"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-lite@6"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-embed@7"></script>
  {% endif %}
</head>
<body>
  <div class="glyf-page">
    <header class="glyf-header">
      <div class="glyf-header-top">
        <div class="glyf-header-main">
          <nav class="glyf-breadcrumb" aria-label="Breadcrumb">
            <a href="../index.html">dashboards</a>
            <span>/</span>
            <span>{{ dashboard.name }}</span>
          </nav>
          <div class="glyf-title-row">
            <h1 class="glyf-title">{{ dashboard.title }}</h1>
            <span class="glyf-badge{% if dashboard.toolbar.visibility == 'public' %} glyf-badge-green{% endif %}">
              {{ dashboard.toolbar.visibility }}
            </span>
          </div>
          {% if dashboard.description %}
          <p class="glyf-subtitle">{{ dashboard.description }}</p>
          {% else %}
          <p class="glyf-subtitle">Static dashboard generated from glyf artifacts.</p>
          {% endif %}
          <div class="glyf-tags" aria-label="Dashboard tags">
            <span class="glyf-badge">glyf</span>
            <span class="glyf-badge glyf-badge-blue">dbt</span>
            {% for chart in charts[:3] %}
            <span class="glyf-badge">{{ chart.metadata.chart_type }}</span>
            {% endfor %}
          </div>
        </div>
        {{ toolbar.render_toolbar(dashboard) }}
      </div>
    </header>

    <div class="glyf-meta-bar">
      <div class="glyf-meta-left">
        <div class="glyf-meta-item">
          {{ icons.icon("clock") }}
          Refreshed <strong>on build</strong>
        </div>
        <div class="glyf-meta-item">
          {{ icons.icon("user") }}
          Owner <strong>data team</strong>
        </div>
        <div class="glyf-meta-item glyf-mono">
          {{ icons.icon("code") }}
          <span>{{ charts | length }} chart{% if charts | length != 1 %}s{% endif %}</span>
        </div>
      </div>
      <div class="glyf-meta-right">
        {% if dashboard_config.show_compiled_sql %}
        <button class="glyf-source-toggle" type="button" id="glyf-source-button" data-glyf-source-button>
          {{ icons.icon("code") }}
          Source
        </button>
        {% endif %}
        <div class="glyf-version-menu" data-glyf-version-menu>
          <button
            class="glyf-version-button"
            type="button"
            aria-label="Dashboard version"
            aria-expanded="false"
            data-glyf-version-button
          >
            <span class="glyf-version-button-label glyf-mono">v current</span>
            {{ icons.icon("chevron-down", "glyf-version-button-icon") }}
          </button>
          <div class="glyf-version-popover" role="menu" aria-label="Dashboard version options" data-glyf-version-popover>
            <button class="glyf-version-option is-active" type="button" role="menuitem">
              <span class="glyf-version-option-title glyf-mono">v current</span>
              <span class="glyf-version-option-note">generated locally</span>
            </button>
            <button class="glyf-version-option" type="button" role="menuitem" disabled>
              <span class="glyf-version-option-title glyf-mono">v previous</span>
              <span class="glyf-version-option-note">not available in static output</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="glyf-control-bar">
      <span class="glyf-control-label">Filters</span>
      <div class="glyf-filter-chip">
        {{ icons.icon("info") }}
        None
        <span class="glyf-filter-value">static</span>
      </div>
      <button class="glyf-filter-add" type="button" disabled>
        {{ icons.icon("plus") }}
        Add filter
      </button>
      <span class="glyf-static-note">
        {{ icons.icon("lock") }}
        static render
      </span>
    </div>

    <div class="glyf-main">
      {{ source_drawer.render_source_drawer(charts, dashboard_config) }}

      <main class="glyf-content">
        {% if dashboard.sections %}
          {% for section in dashboard.sections %}
          {% set section_columns = section.columns or dashboard.layout_config.columns or 3 %}
          {% if section.column_template %}
          {% set column_template = section.column_template %}
          {% elif section.columns %}
          {% set column_template = none %}
          {% else %}
          {% set column_template = dashboard.layout_config.column_template %}
          {% endif %}
          <section class="glyf-section" aria-label="{{ section.title or 'Dashboard section' }}">
            {% if section.title or section.description %}
            <div class="glyf-section-head">
              {% if section.title %}
              <h2 class="glyf-section-title">{{ section.title }}</h2>
              {% endif %}
              {% if section.description %}
              <p class="glyf-section-description">{{ section.description }}</p>
              {% endif %}
            </div>
            {% endif %}
            <div
              class="glyf-chart-grid"
              style="--glyf-columns: {{ section_columns }}{% if column_template %}; --glyf-column-template: {{ column_template }}{% endif %}"
            >
              {% for item in section.items %}
                {% if item.kind == "chart" and item.chart %}
                  {{ chart_cards.render_chart_card(chart_artifacts[item.chart], dashboard_config, item.title, item.width) }}
                {% elif item.kind == "component" and item.component_spec %}
                  {{ component_cards.render_component_card(item.component_spec, item.width) }}
                {% elif item.kind == "markdown" %}
                  {{ component_cards.render_markdown_card(item) }}
                {% elif item.kind == "metric" %}
                  {{ component_cards.render_metric_card(item) }}
                {% endif %}
              {% endfor %}
            </div>
          </section>
          {% endfor %}
        {% else %}
        <section class="glyf-section" aria-label="Charts">
          <div class="glyf-chart-grid" data-auto-columns="true">
            {% for chart in charts %}
            {{ chart_cards.render_chart_card(chart, dashboard_config) }}
            {% endfor %}
          </div>
        </section>
        {% endif %}
      </main>
    </div>

    {{ ai_panel.render_ai_panel(dashboard) }}

    <div class="glyf-modal-backdrop" id="glyf-lookback-modal" data-glyf-modal>
      <div class="glyf-modal" role="dialog" aria-modal="true" aria-label="Lookback chart versions">
        <div class="glyf-modal-head">
          <div class="glyf-modal-title">Lookback chart versions</div>
          <button class="glyf-close-btn" type="button" aria-label="Close lookback" data-glyf-lookback-close>x</button>
        </div>
        <div>
          <div class="glyf-version-row">
            <div>
              <div class="glyf-version-title">current build</div>
              <div class="glyf-version-date">generated locally</div>
            </div>
            <span class="glyf-badge glyf-badge-green">current</span>
          </div>
          <div class="glyf-version-row">
            <div>
              <div class="glyf-version-title">previous build</div>
              <div class="glyf-version-date">not available in static output</div>
            </div>
            <span class="glyf-badge">static</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if has_interactive_charts %}
  <script>
    document.querySelectorAll("[data-vega-chart]").forEach((container) => {
      const specElement = document.getElementById(container.dataset.vegaChart);
      if (!specElement) {
        return;
      }
      const spec = JSON.parse(specElement.textContent);
      vegaEmbed(container, spec, { actions: false, renderer: "svg" });
    });
  </script>
  {% endif %}
  <script>
    const sourceButton = document.querySelector("[data-glyf-source-button]");
    const sourceDrawer = document.getElementById("glyf-source-drawer");
    if (sourceButton && sourceDrawer) {
      sourceButton.addEventListener("click", () => {
        sourceButton.classList.toggle("is-active");
        sourceDrawer.classList.toggle("is-open");
      });
    }

    const aiButton = document.querySelector("[data-glyf-ai-button]");
    const aiClose = document.querySelector("[data-glyf-ai-close]");
    const aiPanel = document.getElementById("glyf-ai-panel");
    const toggleAi = () => {
      if (!aiPanel || !aiButton) {
        return;
      }
      aiPanel.classList.toggle("is-open");
      aiButton.classList.toggle("is-active");
    };
    if (aiButton) {
      aiButton.addEventListener("click", toggleAi);
    }
    if (aiClose) {
      aiClose.addEventListener("click", toggleAi);
    }

    const lookbackButton = document.querySelector("[data-glyf-lookback]");
    const lookbackClose = document.querySelector("[data-glyf-lookback-close]");
    const lookbackModal = document.getElementById("glyf-lookback-modal");
    if (lookbackButton && lookbackModal) {
      lookbackButton.addEventListener("click", () => {
        lookbackModal.classList.add("is-open");
      });
    }
    if (lookbackClose && lookbackModal) {
      lookbackClose.addEventListener("click", () => {
        lookbackModal.classList.remove("is-open");
      });
    }
    if (lookbackModal) {
      lookbackModal.addEventListener("click", (event) => {
        if (event.target === lookbackModal) {
          lookbackModal.classList.remove("is-open");
        }
      });
    }

    const versionMenu = document.querySelector("[data-glyf-version-menu]");
    const versionButton = document.querySelector("[data-glyf-version-button]");
    if (versionMenu && versionButton) {
      const closeVersionMenu = () => {
        versionMenu.classList.remove("is-open");
        versionButton.setAttribute("aria-expanded", "false");
      };
      versionButton.addEventListener("click", () => {
        const next = !versionMenu.classList.contains("is-open");
        versionMenu.classList.toggle("is-open", next);
        versionButton.setAttribute("aria-expanded", next ? "true" : "false");
      });
      document.addEventListener("click", (event) => {
        if (!versionMenu.contains(event.target)) {
          closeVersionMenu();
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeVersionMenu();
        }
      });
    }
  </script>
</body>
</html>
