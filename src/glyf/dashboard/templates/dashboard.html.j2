{%- import "components/icons.j2" as icons -%}
{%- import "components/toolbar.j2" as toolbar -%}
{%- import "components/chart_card.j2" as chart_cards -%}
{%- import "components/table_card.j2" as table_cards -%}
{%- import "components/kpi_card.j2" as kpi_cards -%}
{%- import "components/component_card.j2" as component_cards -%}
{%- import "components/source_drawer.j2" as source_drawer -%}
{%- import "components/ai_panel.j2" as ai_panel -%}
{%- import "components/lineage_view.j2" as lineage_view -%}
<!doctype html>
<html lang="en" data-theme="{{ dashboard_theme }}" data-glyf-chart-follows="{{ 'true' if dashboard.chart_theme in (none, 'auto') else 'false' }}">
<head>
  <meta charset="utf-8">
  <script>try { var t = localStorage.getItem("glyf-theme"); if (t === "light" || t === "dark") { document.documentElement.setAttribute("data-theme", t); } } catch (e) {}</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ dashboard.title }}</title>
  {% if assets.inline_css %}
  <style>{{ assets.inline_css }}</style>
  {% else %}
  <link rel="stylesheet" href="../{{ assets.css_href }}">
  {% endif %}
  {% if needs_vega %}
  <script src="https://cdn.jsdelivr.net/npm/vega@6"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-lite@6"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-embed@7"></script>
  {% endif %}
</head>
<body>
  <div class="glyf-page">
    <header class="glyf-header">
      <div class="glyf-header-top">
        <div class="glyf-header-main">
          <nav class="glyf-breadcrumb" aria-label="Breadcrumb">
            <a href="../index.html">dashboards</a>
            <span>/</span>
            <span>{{ dashboard.name }}</span>
          </nav>
          <div class="glyf-title-row">
            <h1 class="glyf-title">{{ dashboard.title }}</h1>
            <span class="glyf-badge {% if dashboard.toolbar.visibility == 'public' %}glyf-badge-green{% else %}glyf-badge-amber{% endif %}">
              {{ dashboard.toolbar.visibility }}
            </span>
          </div>
          {% if dashboard.description %}
          <p class="glyf-subtitle">{{ dashboard.description }}</p>
          {% else %}
          <p class="glyf-subtitle">Static dashboard generated from glyf artifacts.</p>
          {% endif %}
          {% if dashboard.tags %}
          <div class="glyf-tags" aria-label="Dashboard tags">
            {% for tag in dashboard.tags %}
            <span class="glyf-badge glyf-tag glyf-tag--{{ tag | tag_tone }}">{{ tag }}</span>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {{ toolbar.render_toolbar(dashboard) }}
      </div>
    </header>

    <div class="glyf-meta-bar">
      <div class="glyf-meta-left">
        <div class="glyf-meta-item">
          {{ icons.icon("clock") }}
          Refreshed <strong title="{{ build_meta.generated_at_iso }}">{{ build_meta.generated_at_display }}</strong>
        </div>
        <div class="glyf-meta-item">
          {{ icons.icon("user") }}
          Owner <strong>data team</strong>
        </div>
        <div class="glyf-meta-item glyf-mono">
          {{ icons.icon("code") }}
          <span>{{ charts | length }} chart{% if charts | length != 1 %}s{% endif %}</span>
        </div>
      </div>
      <div class="glyf-meta-right">
        {% if dashboard_config.show_compiled_sql %}
        <button class="glyf-source-toggle" type="button" id="glyf-source-button" data-glyf-source-button>
          {{ icons.icon("code") }}
          Source
        </button>
        {% endif %}
        {% if lineage is not none %}
        <button class="glyf-source-toggle" type="button" id="glyf-lineage-button" data-glyf-lineage-button aria-pressed="false">
          {{ icons.icon("branch") }}
          Lineage
        </button>
        {% endif %}
        <div class="glyf-version-menu" data-glyf-version-menu>
          <button
            class="glyf-version-button"
            type="button"
            aria-label="Dashboard version"
            aria-expanded="false"
            data-glyf-version-button
          >
            <span class="glyf-version-button-label glyf-mono">v current</span>
            {{ icons.icon("chevron-down", "glyf-version-button-icon") }}
          </button>
          <div class="glyf-version-popover" role="menu" aria-label="Dashboard version options" data-glyf-version-popover>
            <button class="glyf-version-option is-active" type="button" role="menuitem">
              <span class="glyf-version-option-title glyf-mono">v current</span>
              <span class="glyf-version-option-note">built {{ build_meta.generated_at_display }}</span>
            </button>
            <button class="glyf-version-option" type="button" role="menuitem" disabled>
              <span class="glyf-version-option-title glyf-mono">v previous</span>
              <span class="glyf-version-option-note">not available in static output</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="glyf-control-bar"{% if filters.live %} data-glyf-filter-bar{% endif %}>
      <span class="glyf-control-label">Filters</span>
      {% if dashboard.filters and filters.live %}
        {% for filter in dashboard.filters %}
        <label class="glyf-filter-select" data-glyf-filter="{{ filter.field }}">
          {{ icons.icon("filter") }}
          <span class="glyf-filter-field">{{ filter.field }}</span>
          <select class="glyf-filter-control" id="glyf-filter-{{ filter.field }}" data-glyf-filter-select="{{ filter.field }}" aria-label="Filter by {{ filter.field }}">
            <option value="">All</option>
            {% for value in filter.values %}
            <option value="{{ value }}">{{ value }}</option>
            {% endfor %}
          </select>
        </label>
        {% endfor %}
        <button class="glyf-filter-clear" type="button" data-glyf-filter-clear hidden>Clear</button>
      {% elif dashboard.filters %}
        {% for filter in dashboard.filters %}
        <div class="glyf-filter-chip" title="{% if filter.is_sourced %}source({{ filter.source_chart }}, {{ filter.source_field }}){% else %}static values{% endif %}">
          {{ icons.icon("filter") }}
          <span class="glyf-filter-field">{{ filter.field }}</span>
          <span class="glyf-filter-value">{% if filter.values %}{{ filter.values | length }} value{% if filter.values | length != 1 %}s{% endif %}{% else %}no values{% endif %}</span>
        </div>
        {% endfor %}
        <span class="glyf-filter-value">no chart on this page publishes these columns</span>
      {% else %}
        <div class="glyf-filter-chip">
          {{ icons.icon("info") }}
          None
          <span class="glyf-filter-value">static</span>
        </div>
      {% endif %}
      <span class="glyf-static-note">
        {{ icons.icon("lock") }}
        static render
      </span>
    </div>

    <div class="glyf-main">
      {{ source_drawer.render_source_drawer(charts, dashboard_config) }}

      <main class="glyf-content" id="glyf-charts-view">
        {% if dashboard.sections %}
          {% for section in dashboard.sections %}
          {% set section_columns = section.columns or dashboard.layout_config.columns or 3 %}
          {% if section.column_template %}
          {% set column_template = section.column_template %}
          {% elif section.columns %}
          {% set column_template = none %}
          {% else %}
          {% set column_template = dashboard.layout_config.column_template %}
          {% endif %}
          <section class="glyf-section" aria-label="{{ section.title or 'Dashboard section' }}">
            {% if section.title or section.description %}
            <div class="glyf-section-head">
              {% if section.title %}
              <h2 class="glyf-section-title">{{ section.title }}</h2>
              {% endif %}
              {% if section.description %}
              <p class="glyf-section-description">{{ section.description }}</p>
              {% endif %}
            </div>
            {% endif %}
            <div
              class="glyf-chart-grid"
              style="--glyf-columns: {{ section_columns }}{% if column_template %}; --glyf-column-template: {{ column_template }}{% endif %}"
            >
              {% for item in section.items %}
                {% if item.kind == "chart" and item.chart and chart_artifacts[item.chart].metadata.is_table %}
                  {{ table_cards.render_table_card(chart_artifacts[item.chart], item.title, item.width, filters) }}
                {% elif item.kind == "chart" and item.chart and chart_artifacts[item.chart].metadata.is_kpi %}
                  {{ kpi_cards.render_kpi_card(chart_artifacts[item.chart], item.title, item.width, filters) }}
                {% elif item.kind == "chart" and item.chart %}
                  {{ chart_cards.render_chart_card(chart_artifacts[item.chart], dashboard_config, chart_theme, item.title, item.width, filters) }}
                {% elif item.kind == "component" and item.component_spec %}
                  {{ component_cards.render_component_card(item.component_spec, item.width) }}
                {% elif item.kind == "markdown" %}
                  {{ component_cards.render_markdown_card(item) }}
                {% elif item.kind == "metric" %}
                  {{ component_cards.render_metric_card(item) }}
                {% endif %}
              {% endfor %}
            </div>
          </section>
          {% endfor %}
        {% else %}
        <section class="glyf-section" aria-label="Charts">
          <div class="glyf-chart-grid" data-auto-columns="true">
            {% for chart in charts %}
            {% if chart.metadata.is_table %}
            {{ table_cards.render_table_card(chart, filters=filters) }}
            {% elif chart.metadata.is_kpi %}
            {{ kpi_cards.render_kpi_card(chart, filters=filters) }}
            {% else %}
            {{ chart_cards.render_chart_card(chart, dashboard_config, chart_theme, filters=filters) }}
            {% endif %}
            {% endfor %}
          </div>
        </section>
        {% endif %}
      </main>
    </div>

    {{ ai_panel.render_ai_panel(dashboard) }}

    {% if lineage is not none %}
    {{ lineage_view.render_lineage_modal(lineage) }}
    {% endif %}

    <div class="glyf-modal-backdrop" id="glyf-lookback-modal" data-glyf-modal>
      <div class="glyf-modal" role="dialog" aria-modal="true" aria-label="Lookback chart versions">
        <div class="glyf-modal-head">
          <div class="glyf-modal-title">Lookback chart versions</div>
          <button class="glyf-close-btn" type="button" aria-label="Close lookback" data-glyf-lookback-close>x</button>
        </div>
        <div>
          <div class="glyf-version-row">
            <div>
              <div class="glyf-version-title">current build</div>
              <div class="glyf-version-date">{{ build_meta.generated_at_display }}</div>
            </div>
            <span class="glyf-badge glyf-badge-green">current</span>
          </div>
          <div class="glyf-version-row">
            <div>
              <div class="glyf-version-title">previous build</div>
              <div class="glyf-version-date">not available in static output</div>
            </div>
            <span class="glyf-badge">static</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if has_tables %}
  <script>
    // Click a header to sort a table by that column; click again to reverse.
    // The rows are the build's; sorting only reorders what is already here.
    document.querySelectorAll("[data-glyf-table]").forEach((table) => {
      const body = table.querySelector("tbody");
      const headers = Array.from(table.querySelectorAll("th[data-column]"));
      headers.forEach((header, index) => {
        header.addEventListener("click", () => {
          const ascending = header.getAttribute("aria-sort") !== "ascending";
          const numeric = header.dataset.type === "number";
          const rows = Array.from(body.querySelectorAll("tr"));
          const key = (row) => {
            const cell = row.children[index];
            if (!cell || cell.dataset.empty === "true") {
              return null;
            }
            return numeric ? Number(cell.textContent) : cell.textContent;
          };
          rows.sort((a, b) => {
            const left = key(a);
            const right = key(b);
            if (left === null && right === null) return 0;
            if (left === null) return 1;
            if (right === null) return -1;
            const order = numeric ? left - right : String(left).localeCompare(String(right));
            return ascending ? order : -order;
          });
          rows.forEach((row) => body.appendChild(row));
          headers.forEach((other) => other.setAttribute("aria-sort", "none"));
          header.setAttribute("aria-sort", ascending ? "ascending" : "descending");
        });
      });
    });
  </script>
  {% endif %}
  {% if has_interactive_charts %}
  <script>
    document.querySelectorAll("[data-vega-chart]").forEach((container) => {
      const specElement = document.getElementById(container.dataset.vegaChart);
      if (!specElement) {
        return;
      }
      const spec = JSON.parse(specElement.textContent);
      vegaEmbed(container, spec, { actions: false, renderer: "svg" });
    });
  </script>
  {% endif %}
  {% if lineage is not none and not lineage.is_empty %}
  <script>
    (function () {
      // Lineage opens as a window over the dashboard, like Lookback.
      const button = document.querySelector("[data-glyf-lineage-button]");
      const modal = document.getElementById("glyf-lineage-modal");
      if (!button || !modal) return;
      const setOpen = (open) => {
        modal.classList.toggle("is-open", open);
        button.classList.toggle("is-active", open);
        button.setAttribute("aria-pressed", open ? "true" : "false");
      };
      button.addEventListener("click", () => setOpen(!modal.classList.contains("is-open")));
      modal.querySelector("[data-glyf-lineage-close]").addEventListener("click", () => setOpen(false));
      modal.addEventListener("click", (event) => { if (event.target === modal) setOpen(false); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && modal.classList.contains("is-open")) setOpen(false); });

      const wrap = modal.querySelector("[data-glyf-lineage]");
      const svg = wrap.querySelector("svg");
      const canvas = wrap.querySelector("[data-glyf-lineage-canvas]");
      const nodes = Array.from(wrap.querySelectorAll("[data-node]"));
      const edges = Array.from(wrap.querySelectorAll("path[data-from]"));

      // Tracing: light the node, everything upstream and everything downstream.
      const up = new Map(), down = new Map();
      edges.forEach((edge) => {
        const a = edge.dataset.from, b = edge.dataset.to;
        (down.get(a) || down.set(a, []).get(a)).push(b);
        (up.get(b) || up.set(b, []).get(b)).push(a);
      });
      let current = null;
      const walk = (start, map, seen) => (map.get(start) || []).forEach((n) => { if (!seen.has(n)) { seen.add(n); walk(n, map, seen); } });
      const clear = () => { current = null; wrap.classList.remove("has-focus"); nodes.concat(edges).forEach((el) => el.classList.remove("is-lit")); };
      const trace = (id) => {
        if (current === id) return clear();
        current = id;
        const lit = new Set([id]); walk(id, up, lit); walk(id, down, lit);
        wrap.classList.add("has-focus");
        nodes.forEach((n) => n.classList.toggle("is-lit", lit.has(n.dataset.node)));
        edges.forEach((e) => e.classList.toggle("is-lit", lit.has(e.dataset.from) && lit.has(e.dataset.to)));
      };
      nodes.forEach((node) => {
        node.addEventListener("click", () => trace(node.dataset.node));
        node.addEventListener("keydown", (event) => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); trace(node.dataset.node); } });
      });
      // Pan and zoom: one transform on the canvas group.
      const state = { x: 0, y: 0, k: 1 };
      const apply = () => canvas.setAttribute("transform", `translate(${state.x},${state.y}) scale(${state.k})`);
      const scale = () => { const box = svg.getBoundingClientRect(); const vb = svg.viewBox.baseVal; return { box, sx: vb.width / box.width, sy: vb.height / box.height }; };
      const zoomBy = (factor, cx, cy) => {
        const k = Math.min(3, Math.max(0.4, state.k * factor));
        const { box, sx, sy } = scale();
        const px = (cx - box.left) * sx, py = (cy - box.top) * sy;
        state.x = px - (px - state.x) * (k / state.k);
        state.y = py - (py - state.y) * (k / state.k);
        state.k = k; apply();
      };
      wrap.addEventListener("wheel", (event) => { event.preventDefault(); zoomBy(event.deltaY < 0 ? 1.12 : 1 / 1.12, event.clientX, event.clientY); }, { passive: false });
      wrap.querySelectorAll("[data-glyf-zoom]").forEach((control) => control.addEventListener("click", () => {
        const { box } = scale(); const cx = box.left + box.width / 2, cy = box.top + box.height / 2;
        if (control.dataset.glyfZoom === "in") zoomBy(1.25, cx, cy);
        else if (control.dataset.glyfZoom === "out") zoomBy(1 / 1.25, cx, cy);
        else { state.x = 0; state.y = 0; state.k = 1; apply(); }
      }));
      let drag = null;
      wrap.addEventListener("pointerdown", (event) => {
        if (event.target.closest("[data-node], button")) return;
        drag = { x: event.clientX, y: event.clientY, vx: state.x, vy: state.y };
        wrap.classList.add("is-panning"); wrap.setPointerCapture(event.pointerId);
      });
      wrap.addEventListener("pointermove", (event) => {
        if (!drag) return;
        const { sx, sy } = scale();
        state.x = drag.vx + (event.clientX - drag.x) * sx;
        state.y = drag.vy + (event.clientY - drag.y) * sy;
        apply();
      });
      const endDrag = () => { drag = null; wrap.classList.remove("is-panning"); };
      wrap.addEventListener("pointerup", endDrag); wrap.addEventListener("pointercancel", endDrag);

      // The tooltip carries what the node does not: a model's file, a chart's bindings.
      const tip = wrap.querySelector(".glyf-lineage-tip");
      nodes.forEach((node) => {
        const show = () => {
          tip.textContent = node.dataset.tip || ""; tip.hidden = !tip.textContent;
          const r = node.getBoundingClientRect(), w = wrap.getBoundingClientRect();
          tip.style.left = `${r.left - w.left}px`; tip.style.top = `${r.bottom - w.top + 6}px`;
        };
        const hide = () => { tip.hidden = true; };
        node.addEventListener("pointerenter", show); node.addEventListener("pointerleave", hide);
        node.addEventListener("focus", show); node.addEventListener("blur", hide);
      });
    })();
  </script>
  {% endif %}
  <script>
    const sourceButton = document.querySelector("[data-glyf-source-button]");
    const sourceDrawer = document.getElementById("glyf-source-drawer");
    if (sourceButton && sourceDrawer) {
      sourceButton.addEventListener("click", () => {
        sourceButton.classList.toggle("is-active");
        sourceDrawer.classList.toggle("is-open");
      });
    }

    const aiButton = document.querySelector("[data-glyf-ai-button]");
    const aiClose = document.querySelector("[data-glyf-ai-close]");
    const aiPanel = document.getElementById("glyf-ai-panel");
    const toggleAi = () => {
      if (!aiPanel || !aiButton) {
        return;
      }
      aiPanel.classList.toggle("is-open");
      aiButton.classList.toggle("is-active");
    };
    if (aiButton) {
      aiButton.addEventListener("click", toggleAi);
    }
    if (aiClose) {
      aiClose.addEventListener("click", toggleAi);
    }

    const lookbackButton = document.querySelector("[data-glyf-lookback]");
    const lookbackClose = document.querySelector("[data-glyf-lookback-close]");
    const lookbackModal = document.getElementById("glyf-lookback-modal");
    if (lookbackButton && lookbackModal) {
      lookbackButton.addEventListener("click", () => {
        lookbackModal.classList.add("is-open");
      });
    }
    if (lookbackClose && lookbackModal) {
      lookbackClose.addEventListener("click", () => {
        lookbackModal.classList.remove("is-open");
      });
    }
    if (lookbackModal) {
      lookbackModal.addEventListener("click", (event) => {
        if (event.target === lookbackModal) {
          lookbackModal.classList.remove("is-open");
        }
      });
    }

    const versionMenu = document.querySelector("[data-glyf-version-menu]");
    const versionButton = document.querySelector("[data-glyf-version-button]");
    if (versionMenu && versionButton) {
      const closeVersionMenu = () => {
        versionMenu.classList.remove("is-open");
        versionButton.setAttribute("aria-expanded", "false");
      };
      versionButton.addEventListener("click", () => {
        const next = !versionMenu.classList.contains("is-open");
        versionMenu.classList.toggle("is-open", next);
        versionButton.setAttribute("aria-expanded", next ? "true" : "false");
      });
      document.addEventListener("click", (event) => {
        if (!versionMenu.contains(event.target)) {
          closeVersionMenu();
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeVersionMenu();
        }
      });
    }

    (function () {
      // Light or dark, chosen by the reader and remembered in this browser.
      // The page's palette is tokens, so the frame follows on its own; charts
      // drawn at build time get the same colour swaps the build applies.
      const root = document.documentElement;
      const toggle = document.querySelector("[data-glyf-theme-toggle]");
      const chartsFollow = root.dataset.glyfChartFollows !== "false";
      const svgSwaps = [
        ["stroke", "#d9e2ec", "#3f3f46"], ["stroke", "#ddd", "#27272a"], ["stroke", "#888", "#a1a1aa"],
        ["fill", "#000", "#f4f4f5"], ["fill", "black", "#f4f4f5"],
      ];
      const swapAttributes = (svg, dark) => {
        const first = svg.querySelector("rect");
        if (first) {
          const fill = first.getAttribute("fill");
          if (dark && fill === "white") first.setAttribute("fill", "#09090b");
          if (!dark && fill === "#09090b") first.setAttribute("fill", "white");
        }
        svgSwaps.forEach(([attr, light, darkValue]) => {
          const from = dark ? light : darkValue, to = dark ? darkValue : light;
          svg.querySelectorAll(`[${attr}="${from}"]`).forEach((el) => el.setAttribute(attr, to));
        });
      };
      const darkVega = { background: "#09090b", view: { stroke: "#3f3f46", fill: "#09090b" }, axis: { labelColor: "#f4f4f5", titleColor: "#f4f4f5", domainColor: "#a1a1aa", tickColor: "#a1a1aa", gridColor: "#27272a" }, legend: { labelColor: "#f4f4f5", titleColor: "#f4f4f5" }, title: { color: "#f4f4f5", subtitleColor: "#d4d4d8" } };
      const lightVega = { background: "#ffffff", view: { stroke: "#d9e2ec", fill: "#ffffff" }, axis: { labelColor: "#000000", titleColor: "#000000", domainColor: "#888888", tickColor: "#888888", gridColor: "#dddddd" }, legend: { labelColor: "#000000", titleColor: "#000000" }, title: { color: "#000000", subtitleColor: "#52525b" } };
      window.glyfVegaTheme = (spec, dark) => {
        const palette = dark ? darkVega : lightVega;
        spec.background = palette.background;
        spec.config = spec.config || {};
        ["view", "axis", "legend", "title"].forEach((key) => { spec.config[key] = Object.assign({}, spec.config[key] || {}, palette[key]); });
        return spec;
      };
      const themeCharts = (dark) => {
        if (!chartsFollow) return;
        document.querySelectorAll(".glyf-chart-card").forEach((card) => {
          card.setAttribute("data-chart-theme", dark ? "dark" : "light");
          card.querySelectorAll(".glyf-chart-body > svg").forEach((svg) => swapAttributes(svg, dark));
        });
        {% if needs_vega %}
        {
          document.querySelectorAll("[data-vega-chart]").forEach((container) => {
            const specElement = document.getElementById(container.dataset.vegaChart);
            if (!specElement) return;
            vegaEmbed(container, window.glyfVegaTheme(JSON.parse(specElement.textContent), dark), { actions: false, renderer: "svg" });
          });
        }
        {% endif %}
      };
      const buildTheme = "{{ dashboard_theme }}";
      const current = () => root.getAttribute("data-theme") === "dark";
      // The page may have been switched before paint; bring the charts along.
      if (current() !== (buildTheme === "dark")) themeCharts(current());
      if (toggle) {
        toggle.addEventListener("click", () => {
          const dark = !current();
          root.setAttribute("data-theme", dark ? "dark" : "light");
          try { localStorage.setItem("glyf-theme", dark ? "dark" : "light"); } catch (e) {}
          themeCharts(dark);
          if (window.glyfApplyFilters) window.glyfApplyFilters();
        });
      }
    })();

    {% if filters.live %}
    (function () {
      // A filter redraws every chart it can, from the rows the page carries,
      // and dims the ones it cannot: a chart that looks filtered and is not
      // would be worse than one that says so.
      const selects = Array.from(document.querySelectorAll("[data-glyf-filter-select]"));
      const clearButton = document.querySelector("[data-glyf-filter-clear]");
      const cards = Array.from(document.querySelectorAll("[data-glyf-chart]"));
      const active = () => selects.filter((s) => s.value !== "").map((s) => ({ field: s.dataset.glyfFilterSelect, value: s.value }));
      const modesOf = (card) => Object.fromEntries((card.dataset.glyfFilters || "").split(" ").filter(Boolean).map((pair) => pair.split(":")));
      const vegaSpecOf = (card) => {
        const el = card.querySelector('script[type="application/json"]');
        return el ? JSON.parse(el.textContent) : null;
      };
      const isDark = () => document.documentElement.getAttribute("data-theme") === "dark";
      const filterExpr = (pairs) => pairs.map((p) => `toString(datum[${JSON.stringify(p.field)}]) == ${JSON.stringify(p.value)}`).join(" && ");
      const redrawVega = (card, pairs) => {
        const spec = vegaSpecOf(card);
        const target = card.querySelector("[data-glyf-filter-chart], [data-vega-chart]");
        if (!spec || !target || typeof vegaEmbed !== "function") return;
        if (pairs.length) spec.transform = [{ filter: filterExpr(pairs) }].concat(spec.transform || []);
        if (window.glyfVegaTheme) window.glyfVegaTheme(spec, isDark());
        const still = card.querySelector("[data-glyf-still]");
        if (still) { still.hidden = pairs.length > 0; }
        if (target.hasAttribute("data-glyf-filter-chart")) { target.hidden = pairs.length === 0; }
        if (pairs.length || target.hasAttribute("data-vega-chart")) vegaEmbed(target, spec, { actions: false, renderer: "svg" });
      };
      const filterTable = (card, pairs) => {
        const table = card.querySelector("table");
        if (!table) return;
        const headers = Array.from(table.querySelectorAll("th[data-column]")).map((th) => th.dataset.column);
        const rows = Array.from(table.querySelectorAll("tbody tr"));
        let shown = 0;
        rows.forEach((row) => {
          const ok = pairs.every((p) => { const i = headers.indexOf(p.field); return i >= 0 && row.children[i] && row.children[i].textContent === p.value; });
          row.hidden = !ok; if (ok) shown += 1;
        });
        const caption = card.querySelector(".glyf-table-caption");
        if (caption) caption.textContent = pairs.length ? `${shown} of ${rows.length} rows` : `${rows.length} row${rows.length === 1 ? "" : "s"}`;
      };
      const apply = () => {
        const pairs = active();
        if (clearButton) clearButton.hidden = pairs.length === 0;
        cards.forEach((card) => {
          const modes = modesOf(card);
          const applies = pairs.filter((p) => modes[p.field] && modes[p.field] !== "none");
          const cannot = pairs.filter((p) => !modes[p.field] || modes[p.field] === "none");
          const chip = card.querySelector("[data-glyf-filter-applied]");
          const note = card.querySelector("[data-glyf-filter-note]");
          if (chip) { chip.hidden = applies.length === 0; chip.textContent = applies.map((p) => `${p.field} = ${p.value}`).join(", "); }
          card.classList.toggle("is-unfiltered", pairs.length > 0 && cannot.length > 0 && applies.length === 0);
          if (note) { note.hidden = cannot.length === 0; note.textContent = cannot.length ? `not filtered by ${cannot.map((p) => p.field).join(", ")}` : ""; }
          const first = Object.values(modes).find((m) => m !== "none");
          if (first === "vega") redrawVega(card, applies);
          else if (first === "table") filterTable(card, applies);
        });
      };
      selects.forEach((s) => s.addEventListener("change", apply));
      if (clearButton) clearButton.addEventListener("click", () => { selects.forEach((s) => { s.value = ""; }); apply(); });
      window.glyfApplyFilters = apply;
    })();
    {% endif %}

    document.querySelectorAll("[data-glyf-filter-menu]").forEach((menu) => {
      const button = menu.querySelector("[data-glyf-filter-button]");
      if (!button) {
        return;
      }
      const closeMenu = () => {
        menu.classList.remove("is-open");
        button.setAttribute("aria-expanded", "false");
      };
      button.addEventListener("click", () => {
        const next = !menu.classList.contains("is-open");
        document.querySelectorAll("[data-glyf-filter-menu]").forEach((candidate) => {
          if (candidate !== menu) {
            candidate.classList.remove("is-open");
            const candidateButton = candidate.querySelector("[data-glyf-filter-button]");
            if (candidateButton) {
              candidateButton.setAttribute("aria-expanded", "false");
            }
          }
        });
        menu.classList.toggle("is-open", next);
        button.setAttribute("aria-expanded", next ? "true" : "false");
      });
      document.addEventListener("click", (event) => {
        if (!menu.contains(event.target)) {
          closeMenu();
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      });
    });
  </script>
</body>
</html>
