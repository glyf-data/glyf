{% macro render_kpi_card(chart, title=None, width=None, filters=None) -%}
{% set filter_modes = filters.modes(chart.metadata.name) if filters else "" %}
<article class="glyf-card glyf-kpi-card" data-glyf-chart="{{ chart.metadata.name }}"{% if filter_modes %} data-glyf-filters="{{ filter_modes }}"{% endif %}{% if width %} style="--glyf-item-width: {{ width }}"{% endif %}>
  <div class="glyf-card-body">
    <div class="glyf-kpi-label">{{ title or chart.metadata.title or chart.metadata.name }}</div>
    {{ chart.kpi_html | safe }}
    <div class="glyf-filter-note" data-glyf-filter-note hidden></div>
  </div>
  <div class="glyf-card-watermark" data-glyf-watermark aria-hidden="true"></div>
</article>
{%- endmacro %}
