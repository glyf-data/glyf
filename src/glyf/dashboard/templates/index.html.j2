{%- import "components/icons.j2" as icons -%}
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <script>try { var t = localStorage.getItem("glyf-theme"); if (t === "light" || t === "dark") { document.documentElement.setAttribute("data-theme", t); } } catch (e) {}</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>glyf dashboards</title>
  {% if assets.inline_css %}
  <style>{{ assets.inline_css }}</style>
  {% else %}
  <link rel="stylesheet" href="{{ assets.css_href }}">
  {% endif %}
</head>
<body>
  <div class="glyf-page">
    <header class="glyf-header">
      <div class="glyf-header-top">
        <div class="glyf-header-main">
          <nav class="glyf-breadcrumb" aria-label="Breadcrumb">
            <span>glyf</span>
            <span>/</span>
            <span>dashboards</span>
          </nav>
          <div class="glyf-title-row">
            <h1 class="glyf-title">Dashboards</h1>
            <span class="glyf-badge">{{ dashboards | length }}</span>
          </div>
          <p class="glyf-subtitle">Static dashboard pages generated from glyf artifacts.</p>
        </div>
        <div class="glyf-actions" aria-label="Page actions">
          <button class="glyf-icon-btn glyf-theme-toggle" type="button" data-tip="Theme" aria-label="Switch between light and dark" data-glyf-theme-toggle>
            {{ icons.icon("sun", "glyf-theme-icon glyf-theme-icon--light") }}
            {{ icons.icon("moon", "glyf-theme-icon glyf-theme-icon--dark") }}
          </button>
        </div>
      </div>
    </header>
    <main class="glyf-content">
      <section class="glyf-section" aria-label="Dashboards">
        <div class="glyf-chart-grid glyf-index-grid" data-auto-columns="true">
          {% for item in dashboards %}
          <article class="glyf-card glyf-index-card">
            <div class="glyf-card-head glyf-index-card-head">
              <div class="glyf-index-card-heading">
                <div class="glyf-index-card-meta glyf-mono">{{ item.dashboard.name }}</div>
                <a class="glyf-card-title glyf-index-card-title" href="dashboards/{{ item.path.name }}">{{ item.dashboard.title }}</a>
                {% if item.dashboard.description %}
                <div class="glyf-card-subtitle glyf-index-card-subtitle">{{ item.dashboard.description }}</div>
                {% else %}
                <div class="glyf-card-subtitle glyf-index-card-subtitle">Static dashboard generated from glyf artifacts.</div>
                {% endif %}
                {% if item.dashboard.tags %}
                <div class="glyf-tags glyf-index-tags" aria-label="Dashboard tags">
                  {% for tag in item.dashboard.tags[:4] %}
                  <span class="glyf-badge glyf-tag glyf-tag--{{ tag | tag_tone }}">{{ tag }}</span>
                  {% endfor %}
                </div>
                {% endif %}
              </div>
              <div class="glyf-index-card-side">
                <span class="glyf-badge">{{ item.charts | length }} chart{% if item.charts | length != 1 %}s{% endif %}</span>
                <span class="glyf-index-card-link">Open</span>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
    </main>
  </div>
  <script>
    (function () {
      const root = document.documentElement;
      const toggle = document.querySelector("[data-glyf-theme-toggle]");
      if (!toggle) return;
      toggle.addEventListener("click", () => {
        const dark = root.getAttribute("data-theme") !== "dark";
        root.setAttribute("data-theme", dark ? "dark" : "light");
        try { localStorage.setItem("glyf-theme", dark ? "dark" : "light"); } catch (e) {}
      });
    })();
  </script>
</body>
</html>
