<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ dashboard.title }}</title>
  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f7f7f4;
      color: #1f2933;
    }
    body {
      margin: 0;
    }
    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }
    header {
      margin-bottom: 28px;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 2rem;
      line-height: 1.15;
    }
    p {
      margin: 0;
      color: #52606d;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 18px;
    }
    article {
      background: #ffffff;
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      padding: 16px;
    }
    h2 {
      margin: 0 0 12px;
      font-size: 1rem;
    }
    .chart svg {
      width: 100%;
      height: auto;
    }
    .chart img {
      display: block;
      max-width: 100%;
      height: auto;
    }
    details {
      margin-top: 12px;
      border-top: 1px solid #e4e7eb;
      padding-top: 10px;
    }
    summary {
      cursor: pointer;
      color: #334e68;
      font-weight: 600;
    }
    pre {
      overflow-x: auto;
      padding: 12px;
      background: #f0f4f8;
      border-radius: 6px;
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>{{ dashboard.title }}</h1>
      {% if dashboard.description %}
      <p>{{ dashboard.description }}</p>
      {% endif %}
    </header>

    <section class="grid" aria-label="Charts">
      {% for chart in charts %}
      <article>
        <h2>{{ chart.metadata.title or chart.metadata.name }}</h2>
        <div class="chart">
          {% if chart.svg %}
          {{ chart.svg | safe }}
          {% else %}
          <img src="../charts/{{ chart.metadata.png_path.name }}" alt="{{ chart.metadata.title or chart.metadata.name }}">
          {% endif %}
        </div>
        {% if chart.compiled_sql %}
        <details>
          <summary>Compiled SQL</summary>
          <pre><code>{{ chart.compiled_sql }}</code></pre>
        </details>
        {% endif %}
      </article>
      {% endfor %}
    </section>
  </main>
</body>
</html>
