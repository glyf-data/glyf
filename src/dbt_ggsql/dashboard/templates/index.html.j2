<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>dbt-ggsql dashboards</title>
  <style>
    :root {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f7f7f4;
      color: #1f2933;
    }
    body {
      margin: 0;
    }
    main {
      max-width: 880px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }
    h1 {
      margin: 0 0 20px;
      font-size: 2rem;
    }
    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }
    li {
      background: #ffffff;
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      padding: 16px;
    }
    a {
      color: #0b5cad;
      font-weight: 700;
      text-decoration: none;
    }
    p {
      margin: 6px 0 0;
      color: #52606d;
    }
  </style>
</head>
<body>
  <main>
    <h1>Dashboards</h1>
    <ul>
      {% for item in dashboards %}
      <li>
        <a href="dashboards/{{ item.path.name }}">{{ item.dashboard.title }}</a>
        {% if item.dashboard.description %}
        <p>{{ item.dashboard.description }}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </main>
</body>
</html>
