<!doctype html>
<html lang="en" data-theme="{{ dashboard_config.theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ dashboard.title }}</title>
  {% if has_interactive_charts %}
  <script src="https://cdn.jsdelivr.net/npm/vega@6"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-lite@6"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-embed@7"></script>
  {% endif %}
  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f7f7f4;
      color: #1f2933;
    }
    body {
      margin: 0;
    }
    main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 32px 20px 48px;
    }
    header {
      margin-bottom: 28px;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 2rem;
      line-height: 1.15;
    }
    p {
      margin: 0;
      color: #52606d;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(var(--dashboard-columns, auto-fit), minmax(280px, 1fr));
      gap: 18px;
    }
    .grid[data-auto-columns="true"] {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
    .section {
      margin-top: 28px;
    }
    .section:first-of-type {
      margin-top: 0;
    }
    .section-header {
      margin-bottom: 14px;
    }
    .section-header h2 {
      margin: 0 0 6px;
      font-size: 1.25rem;
    }
    article {
      background: #ffffff;
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      padding: 16px;
    }
    .chart-card {
      grid-column: span min(var(--item-width, 1), var(--section-columns, 3));
    }
    .chart-card h3 {
      margin: 0 0 12px;
      font-size: 1rem;
    }
    .markdown-card {
      grid-column: span min(var(--item-width, 1), var(--section-columns, 3));
    }
    .markdown-card h3,
    .metric-card h3 {
      margin: 0 0 10px;
      font-size: 1rem;
    }
    .markdown-card p {
      margin: 0;
      white-space: pre-line;
    }
    .metric-card {
      grid-column: span min(var(--item-width, 1), var(--section-columns, 3));
    }
    .metric-value {
      color: #102a43;
      font-size: 1.9rem;
      font-weight: 800;
      line-height: 1.1;
    }
    .metric-note {
      margin-top: 8px;
    }
    .chart svg {
      width: 100%;
      height: auto;
    }
    .chart img {
      display: block;
      max-width: 100%;
      height: auto;
    }
    .interactive-chart {
      width: 100%;
    }
    .interactive-chart canvas,
    .interactive-chart svg {
      max-width: 100%;
      height: auto;
    }
    details {
      margin-top: 12px;
      border-top: 1px solid #e4e7eb;
      padding-top: 10px;
    }
    summary {
      cursor: pointer;
      color: #334e68;
      font-weight: 600;
    }
    pre {
      overflow-x: auto;
      padding: 12px;
      background: #f0f4f8;
      border-radius: 6px;
      font-size: 0.875rem;
    }
  </style>
</head>
<body>
  {% macro chart_card(chart, title=None, width=None) -%}
  <article class="chart-card"{% if width %} style="--item-width: {{ width }}"{% endif %}>
    <h3>{{ title or chart.metadata.title or chart.metadata.name }}</h3>
    <div class="chart">
      {% if chart.vega_spec %}
      <div
        class="interactive-chart"
        id="chart-{{ chart.metadata.name }}"
        data-vega-chart="chart-{{ chart.metadata.name }}-spec"
      ></div>
      <script type="application/json" id="chart-{{ chart.metadata.name }}-spec">{{ chart.vega_spec | tojson }}</script>
      <noscript>
        <img src="../charts/{{ chart.metadata.png_path.name }}" alt="{{ title or chart.metadata.title or chart.metadata.name }}">
      </noscript>
      {% elif dashboard_config.embed_charts and chart.svg %}
      {{ chart.svg | safe }}
      {% else %}
      <img src="../charts/{{ chart.metadata.png_path.name }}" alt="{{ title or chart.metadata.title or chart.metadata.name }}">
      {% endif %}
    </div>
    {% if dashboard_config.show_compiled_sql and chart.compiled_sql %}
    <details>
      <summary>Compiled SQL</summary>
      <pre><code>{{ chart.compiled_sql }}</code></pre>
    </details>
    {% endif %}
  </article>
  {%- endmacro %}

  <main>
    <header>
      <h1>{{ dashboard.title }}</h1>
      {% if dashboard.description %}
      <p>{{ dashboard.description }}</p>
      {% endif %}
    </header>

    {% if dashboard.sections %}
      {% for section in dashboard.sections %}
      {% set section_columns = section.columns or dashboard.layout_config.columns or 3 %}
      <section class="section" aria-label="{{ section.title or 'Dashboard section' }}">
        {% if section.title or section.description %}
        <div class="section-header">
          {% if section.title %}
          <h2>{{ section.title }}</h2>
          {% endif %}
          {% if section.description %}
          <p>{{ section.description }}</p>
          {% endif %}
        </div>
        {% endif %}
        <div class="grid" style="--dashboard-columns: {{ section_columns }}; --section-columns: {{ section_columns }}">
          {% for item in section.items %}
            {% if item.kind == "chart" and item.chart %}
              {{ chart_card(chart_artifacts[item.chart], item.title, item.width) }}
            {% elif item.kind == "markdown" %}
              <article class="markdown-card">
                {% if item.title %}
                <h3>{{ item.title }}</h3>
                {% endif %}
                <p>{{ item.text }}</p>
              </article>
            {% elif item.kind == "metric" %}
              <article class="metric-card"{% if item.width %} style="--item-width: {{ item.width }}"{% endif %}>
                <h3>{{ item.label }}</h3>
                <div class="metric-value">{{ item.value }}</div>
                {% if item.note %}
                <p class="metric-note">{{ item.note }}</p>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    {% else %}
    <section class="grid" data-auto-columns="true" aria-label="Charts">
      {% for chart in charts %}
      {{ chart_card(chart) }}
      {% endfor %}
    </section>
    {% endif %}
  </main>
  {% if has_interactive_charts %}
  <script>
    document.querySelectorAll("[data-vega-chart]").forEach((container) => {
      const specElement = document.getElementById(container.dataset.vegaChart);
      if (!specElement) {
        return;
      }
      const spec = JSON.parse(specElement.textContent);
      vegaEmbed(container, spec, { actions: false, renderer: "svg" });
    });
  </script>
  {% endif %}
</body>
</html>
